---
import { getCollection } from 'astro:content';
import { getPostMetadata, isPublished } from '../utils';

interface TreeNode {
  folders: Map<string, TreeNode>;
  files: Array<{ title: string; slug: string }>;
}

const allPosts = await getCollection('posts', isPublished);
const root: TreeNode = { folders: new Map(), files: [] };

// 1. Build tree - (Kept as is, already efficient with Maps)
for (const post of allPosts) {
  const { title, slug } = getPostMetadata(post);
  const parts = post.id.split('/');
  parts.pop(); 

  let current = root;
  for (const segment of parts) {
    if (!current.folders.has(segment)) {
      current.folders.set(segment, { folders: new Map(), files: [] });
    }
    current = current.folders.get(segment)!;
  }
  current.files.push({ title, slug });
}

// 2. Optimized Recursive Renderer
function renderTree(node: TreeNode, path = ''): string {
  const buffer: string[] = [];

  // Sort folders once
  const sortedFolders = Array.from(node.folders.entries())
    .sort(([a], [b]) => a.localeCompare(b));

  for (const [name, subFolder] of sortedFolders) {
    const folderPath = path ? `${path}/${name}` : name;
    // We use a data-attribute selector that is easy to target specifically
    buffer.push(`
      <details class="folder-group" data-path="${folderPath}">
        <summary class="folder-summary">
          <span class="folder-arrow" aria-hidden="true">▾</span>
          <span class="folder-name">${name}</span>
        </summary>
        <div class="folder-children">
          ${renderTree(subFolder, folderPath)}
        </div>
      </details>
    `);
  }

  const sortedFiles = node.files.sort((a, b) => a.title.localeCompare(b.title));
  if (sortedFiles.length > 0) {
    buffer.push('<ul class="file-list">');
    for (const file of sortedFiles) {
      buffer.push(`
        <li class="file-item">
          <a href="/${file.slug}" class="file-link">${file.title}</a>
        </li>
      `);
    }
    buffer.push('</ul>');
  }

  return buffer.join('');
}

const treeHtml = renderTree(root);
---

<nav-explorer class="explorer">
  <div class="explorer-header" role="presentation">Explorer ▾</div>
  <div class="explorer-tree" set:html={treeHtml} />
</nav-explorer>

<script>
  class NavExplorer extends HTMLElement {
    private KEY = 'open-folders';

    connectedCallback() {
      this.restoreState();

      // Listen for toggles via event delegation (Capture phase)
      this.addEventListener('toggle', (e) => {
        const el = e.target as HTMLDetailsElement;
        const path = el.dataset.path;
        if (path) this.saveState(path, el.open);
      }, true);
    }

    private restoreState() {
      try {
        const saved = localStorage.getItem(this.KEY);
        if (!saved) return;
        
        const openFolders = JSON.parse(saved) as string[];
        if (!Array.isArray(openFolders)) return;

        // PERFORMANCE: Instead of querySelectorAll('*'), 
        // we only find the specific folders that need to be opened.
        // This is significantly faster for large trees.
        for (const path of openFolders) {
          const folder = this.querySelector(`details[data-path="${CSS.escape(path)}"]`) as HTMLDetailsElement;
          if (folder) folder.open = true;
        }
      } catch (e) {
        console.error("Failed to restore explorer state", e);
      }
    }

    private saveState(path: string, isOpen: boolean) {
      const openFolders = new Set(JSON.parse(localStorage.getItem(this.KEY) || '[]'));
      
      if (isOpen) openFolders.add(path);
      else openFolders.delete(path);

      localStorage.setItem(this.KEY, JSON.stringify(Array.from(openFolders)));
    }
  }

  if (!customElements.get('nav-explorer')) {
    customElements.define('nav-explorer', NavExplorer);
  }
</script>

<style is:global>
  /* ... existing styles ... */
  
  .explorer-tree {
    /* Containment hints for the browser */
    contain: content;
  }

  .folder-children {
    padding-left: 0.75rem;
    margin-left: 0.5rem;
    border-left: 1.5px solid #e2e8f0;
    
    /* PERFORMANCE: content-visibility is the biggest win for deep trees.
       It prevents the browser from painting/calculating hidden branches. */
    content-visibility: auto;
    contain-intrinsic-size: 1px 1px; 
  }

  /* When the folder is open, allow it to take up its natural height */
  details[open] > .folder-children {
    content-visibility: visible;
  }

  .folder-group {
    margin-bottom: 0.25rem;
    /* Use contain: paint to isolate each folder's rendering */
    contain: paint;
  }

  .folder-summary {
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.3rem;
    border-radius: 4px;
    color: #334155;
    font-weight: 500;
    list-style: none;
    transition: background 0.1s ease;
    /* Prevent text selection while clicking fast */
    user-select: none;
  }

  .folder-summary::-webkit-details-marker {
    display: none;
  }

  .folder-arrow {
    display: inline-block;
    font-size: 0.75rem;
    color: #94a3b8;
    transition: transform 0.15s ease;
    width: 12px;
    text-align: center;
  }

  details:not([open]) > .folder-summary .folder-arrow {
    transform: rotate(-90deg);
  }

  .file-list {
    list-style: none;
    padding: 0;
    margin: 0.2rem 0;
  }

  .file-link {
    display: block;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    color: #64748b;
    text-decoration: none;
    line-height: 1.4;
    /* Optimization: Hardware acceleration hint for smoother hover transitions */
    will-change: background, color;
  }
</style>