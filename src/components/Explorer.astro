---
import { folderPathKey, getHouseRooms, getPublishedNotes, prettyFolderSegment, slugify } from '../utils';

interface TreeNode {
  name: string;
  parts: string[];
  folders: Map<string, TreeNode>;
  files: Array<{ title: string; slug: string; date: number }>;
}

const notes = await getPublishedNotes();
const rooms = await getHouseRooms();
const root: TreeNode = { name: '', parts: [], folders: new Map(), files: [] };

function ensureRoom(parts: string[]) {
  let current = root;
  for (const segment of parts) {
    const key = slugify(segment);
    const name = prettyFolderSegment(segment);
    if (!current.folders.has(key)) {
      current.folders.set(key, {
        name,
        parts: [...current.parts, name],
        folders: new Map(),
        files: [],
      });
    }
    current = current.folders.get(key)!;
    if (name.includes(' ') && current.name !== name) current.name = name;
  }
  return current;
}

for (const parts of rooms) ensureRoom(parts);

for (const note of notes) {
  const current = ensureRoom(note.folderParts);
  current.files.push({
    title: note.title,
    slug: note.slug,
    date: note.date.getTime(),
  });
}

function escapeHtml(value: string): string {
  return value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function renderTree(node: TreeNode): string {
  const buffer: string[] = [];

  const childRooms = [...node.folders.values()].sort((a, b) =>
    a.name.localeCompare(b.name, undefined, { numeric: true })
  );

  for (const room of childRooms) {
    const path = folderPathKey(room.parts);
    buffer.push(`
      <details class="folder-group" data-path="${escapeHtml(path)}">
        <summary class="folder-summary">
          <span class="folder-arrow" aria-hidden="true">▾</span>
          <span class="folder-name">${escapeHtml(room.name)}</span>
        </summary>
        <div class="folder-children">
          ${renderTree(room)}
        </div>
      </details>
    `);
  }

  const files = [...node.files].sort((a, b) => b.date - a.date || a.title.localeCompare(b.title));
  if (files.length > 0) {
    buffer.push('<ul class="file-list">');
    for (const file of files) {
      buffer.push(`
        <li class="file-item">
          <a href="/${escapeHtml(file.slug)}" class="file-link" data-astro-prefetch>${escapeHtml(file.title)}</a>
        </li>
      `);
    }
    buffer.push('</ul>');
  }

  return buffer.join('');
}

const treeHtml = renderTree(root);
---

<nav-explorer class="explorer">
  <div class="explorer-header">Explorer</div>
  <div class="explorer-tree" set:html={treeHtml} />
</nav-explorer>

<script>
  class NavExplorer extends HTMLElement {
    private KEY = 'open-folders';
    private bound = false;

    connectedCallback() {
      this.restoreState();
      if (this.bound) return;
      this.bound = true;

      this.addEventListener('toggle', (e) => {
        const el = e.target;
        if (!(el instanceof HTMLDetailsElement)) return;
        const path = el.dataset.path;
        if (path) this.saveState(path, el.open);
      }, true);
    }

    private restoreState() {
      try {
        const saved = localStorage.getItem(this.KEY);
        if (!saved) return;
        const openFolders = JSON.parse(saved);
        if (!Array.isArray(openFolders)) return;

        for (const path of openFolders) {
          if (typeof path !== 'string') continue;
          const folder = this.querySelector(`details[data-path="${CSS.escape(path)}"]`);
          if (folder instanceof HTMLDetailsElement) folder.open = true;
        }
      } catch {
        localStorage.removeItem(this.KEY);
      }
    }

    private saveState(path: string, isOpen: boolean) {
      if (!path) return;
      let openFolders: string[] = [];
      try {
        const parsed = JSON.parse(localStorage.getItem(this.KEY) || '[]');
        if (Array.isArray(parsed)) openFolders = parsed.filter((item) => typeof item === 'string');
      } catch {
        openFolders = [];
      }

      const next = new Set(openFolders);
      if (isOpen) next.add(path);
      else next.delete(path);
      localStorage.setItem(this.KEY, JSON.stringify([...next]));
    }
  }

  if (!customElements.get('nav-explorer')) {
    customElements.define('nav-explorer', NavExplorer);
  }
</script>

<style is:global>
  .explorer-header {
    font-size: 0.8rem;
    font-weight: 700;
    color: #64748b;
    letter-spacing: 0.02em;
    margin-bottom: 0.5rem;
  }

  .folder-group {
    margin-bottom: 0.15rem;
  }

  .folder-children {
    padding-left: 0.75rem;
    margin-left: 0.45rem;
    border-left: 1.5px solid #e2e8f0;
  }

  .folder-summary {
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.3rem;
    border-radius: 4px;
    color: #334155;
    font-weight: 500;
    list-style: none;
    user-select: none;
  }

  .folder-summary::-webkit-details-marker {
    display: none;
  }

  .folder-summary:hover {
    background: #f8fafc;
  }

  .folder-arrow {
    display: inline-block;
    font-size: 0.75rem;
    color: #94a3b8;
    width: 12px;
    text-align: center;
    flex: 0 0 12px;
  }

  details:not([open]) > .folder-summary .folder-arrow {
    transform: rotate(-90deg);
  }

  .folder-name {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .file-list {
    list-style: none;
    padding: 0;
    margin: 0.15rem 0 0.35rem;
  }

  .file-link {
    display: block;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    color: #64748b;
    text-decoration: none;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .file-link:hover {
    background: #f0f9ff;
    color: #0369a1;
  }
</style>
