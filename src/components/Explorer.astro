---
import { getCollection } from 'astro:content';
import { getPostMetadata, isPublished, slugify } from '../utils';

interface TreeNode {
  name: string;
  path: string;
  folders: Map<string, TreeNode>;
  files: Array<{ title: string; slug: string }>;
}

const allPosts = await getCollection('posts', isPublished);

// 1. Build a recursive tree from post.id paths
const root: TreeNode = {
  name: 'root',
  path: '',
  folders: new Map(),
  files: [],
};

for (const post of allPosts) {
  const { title, slug } = getPostMetadata(post);
  // Split path: "03 bed/corner/plushie.md" -> ["03 bed", "corner", "plushie.md"]
  const parts = post.id.split('/');
  parts.pop(); // Remove filename, remaining parts are folder segments

  let current = root;
  let accumulatedPath = '';

  for (const segment of parts) {
    accumulatedPath = accumulatedPath ? `${accumulatedPath}/${segment}` : segment;

    if (!current.folders.has(segment)) {
      current.folders.set(segment, {
        name: segment,
        path: accumulatedPath,
        folders: new Map(),
        files: [],
      });
    }
    current = current.folders.get(segment)!;
  }

  current.files.push({ title, slug });
}

// 2. Recursive function to generate nested <details><summary> HTML
function renderTree(node: TreeNode): string {
  let html = '';

  // Sort subfolders alphabetically/numerically (e.g. 01, 02, 03...)
  const sortedFolders = Array.from(node.folders.keys()).sort();
  for (const folderName of sortedFolders) {
    const subFolder = node.folders.get(folderName)!;
    html += `
      <details open class="folder-group">
        <summary class="folder-summary">
          <span class="folder-arrow">▾</span>
          <span class="folder-name">${subFolder.name}</span>
        </summary>
        <div class="folder-children">
          ${renderTree(subFolder)}
        </div>
      </details>
    `;
  }

  // Sort notes alphabetically
  const sortedFiles = node.files.sort((a, b) => a.title.localeCompare(b.title));
  if (sortedFiles.length > 0) {
    html += `<ul class="file-list">`;
    for (const file of sortedFiles) {
      html += `
        <li class="file-item">
          <a href="/${file.slug}" class="file-link">${file.title}</a>
        </li>
      `;
    }
    html += `</ul>`;
  }

  return html;
}

const treeHtml = renderTree(root);
---

<nav class="explorer">
  <div class="explorer-header">Explorer ▾</div>
  <div class="explorer-tree" set:html={treeHtml} />
</nav>

<style is:global>
  .explorer {
    font-size: 0.88rem;
    user-select: none;
  }
  .explorer-header {
    font-weight: 700;
    margin-bottom: 0.6rem;
    color: #475569;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Folder groups */
  .folder-group {
    margin-bottom: 0.25rem;
  }
  .folder-summary {
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.3rem;
    border-radius: 4px;
    color: #334155;
    font-weight: 500;
    list-style: none; /* Hide default browser triangle */
    transition: background 0.1s ease;
  }
  .folder-summary::-webkit-details-marker {
    display: none;
  }
  .folder-summary:hover {
    background: #f1f5f9;
    color: #0369a1;
  }

  /* Arrow rotation */
  .folder-arrow {
    display: inline-block;
    font-size: 0.75rem;
    color: #94a3b8;
    transition: transform 0.15s ease;
    width: 12px;
    text-align: center;
  }
  details:not([open]) > .folder-summary .folder-arrow {
    transform: rotate(-90deg);
  }

  /* Obsidian-style Tree Indent Guide Lines */
  .folder-children {
    padding-left: 0.75rem;
    margin-left: 0.5rem;
    border-left: 1.5px solid #e2e8f0;
  }

  /* File Lists */
  .file-list {
    list-style: none;
    padding: 0;
    margin: 0.2rem 0;
  }
  .file-item {
    margin: 0.15rem 0;
  }
  .file-link {
    display: block;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    color: #64748b;
    text-decoration: none;
    line-height: 1.4;
    transition: all 0.1s ease;
  }
  .file-link:hover {
    background: #f8fafc;
    color: #0284c7;
    text-decoration: none;
  }
</style>