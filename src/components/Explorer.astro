---
import { getCollection } from 'astro:content';
import { getPostMetadata, isPublished } from '../utils';

interface TreeNode {
  name: string;
  path: string;
  folders: Map<string, TreeNode>;
  files: Array<{ title: string; slug: string }>;
}

const allPosts = await getCollection('posts', isPublished);

const root: TreeNode = {
  name: 'root',
  path: '',
  folders: new Map(),
  files: [],
};

for (const post of allPosts) {
  const { title, slug } = getPostMetadata(post);
  const parts = post.id.split('/');
  parts.pop();

  let current = root;
  let accumulatedPath = '';

  for (const segment of parts) {
    accumulatedPath = accumulatedPath ? `${accumulatedPath}/${segment}` : segment;

    if (!current.folders.has(segment)) {
      current.folders.set(segment, {
        name: segment,
        path: accumulatedPath,
        folders: new Map(),
        files: [],
      });
    }
    current = current.folders.get(segment)!;
  }

  current.files.push({ title, slug });
}

function renderTree(node: TreeNode): string {
  let html = '';

  const sortedFolders = Array.from(node.folders.keys()).sort();
  for (const folderName of sortedFolders) {
    const subFolder = node.folders.get(folderName)!;
    
    // 1. Removed `open` (collapsed by default)
    // 2. Added data-path as a unique storage key
    html += `
      <details class="folder-group" data-path="${encodeURIComponent(subFolder.path)}">
        <summary class="folder-summary">
          <span class="folder-arrow">▾</span>
          <span class="folder-name">${subFolder.name}</span>
        </summary>
        <div class="folder-children">
          ${renderTree(subFolder)}
        </div>
      </details>
    `;
  }

  const sortedFiles = node.files.sort((a, b) => a.title.localeCompare(b.title));
  if (sortedFiles.length > 0) {
    html += `<ul class="file-list">`;
    for (const file of sortedFiles) {
      // Added trailing slash to prevent 301 redirects
      html += `
        <li class="file-item">
          <a href="/${file.slug}" class="file-link">${file.title}</a>
        </li>
      `;
    }
    html += `</ul>`;
  }

  return html;
}

const treeHtml = renderTree(root);
---

<nav-explorer class="explorer">
  <div class="explorer-header">Explorer ▾</div>
  <div class="explorer-tree" set:html={treeHtml} />
</nav-explorer>

<script>
  const STORAGE_KEY = 'astro_explorer_open_folders';

  class NavExplorer extends HTMLElement {
    private openFolders = new Set<string>();

    connectedCallback() {
      this.loadSavedState();
      this.restoreOpenFolders();
      this.highlightAndExpandActivePage();

      // Listen to toggles (using capture phase because 'toggle' does not bubble)
      this.addEventListener('toggle', this.handleToggle, true);
    }

    disconnectedCallback() {
      this.removeEventListener('toggle', this.handleToggle, true);
    }

    private loadSavedState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        this.openFolders = new Set(raw ? JSON.parse(raw) : []);
      } catch {
        this.openFolders = new Set();
      }
    }

    private saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(Array.from(this.openFolders)));
      } catch (err) {
        console.error('Failed to save explorer state', err);
      }
    }

    private restoreOpenFolders() {
      const detailsList = this.querySelectorAll<HTMLDetailsElement>('details.folder-group');
      for (const details of detailsList) {
        const path = details.dataset.path;
        if (path && this.openFolders.has(path)) {
          details.open = true;
        }
      }
    }

    // Auto-opens parent folders of current page so the user isn't lost
    private highlightAndExpandActivePage() {
      const currentPath = window.location.pathname;
      const links = this.querySelectorAll<HTMLAnchorElement>('.file-link');

      for (const link of links) {
        if (link.getAttribute('href') === currentPath) {
          link.classList.add('active');

          // Traverse up and open all parent folders of the active note
          let parent = link.closest('details.folder-group');
          while (parent) {
            (parent as HTMLDetailsElement).open = true;
            if (parent.dataset.path) {
              this.openFolders.add(parent.dataset.path);
            }
            parent = parent.parentElement?.closest('details.folder-group') || null;
          }
          this.saveState();
          break;
        }
      }
    }

    private handleToggle = (e: Event) => {
      const details = e.target as HTMLDetailsElement;
      if (details.tagName !== 'DETAILS' || !details.dataset.path) return;

      const path = details.dataset.path;
      if (details.open) {
        this.openFolders.add(path);
      } else {
        this.openFolders.delete(path);
      }

      this.saveState();
    };
  }

  if (!customElements.get('nav-explorer')) {
    customElements.define('nav-explorer', NavExplorer);
  }
</script>

<style is:global>
  nav-explorer.explorer {
    display: block;
    font-size: 0.88rem;
    user-select: none;
  }
  .explorer-header {
    font-weight: 700;
    margin-bottom: 0.6rem;
    color: #475569;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Folder groups */
  .folder-group {
    margin-bottom: 0.25rem;
  }
  .folder-summary {
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.3rem;
    border-radius: 4px;
    color: #334155;
    font-weight: 500;
    list-style: none;
    transition: background 0.1s ease;
  }
  .folder-summary::-webkit-details-marker {
    display: none;
  }
  .folder-summary:hover {
    background: #f1f5f9;
    color: #0369a1;
  }

  /* Arrow rotation */
  .folder-arrow {
    display: inline-block;
    font-size: 0.75rem;
    color: #94a3b8;
    transition: transform 0.15s ease;
    width: 12px;
    text-align: center;
  }
  details:not([open]) > .folder-summary .folder-arrow {
    transform: rotate(-90deg);
  }

  /* Obsidian-style Tree Indent Guide Lines */
  .folder-children {
    padding-left: 0.75rem;
    margin-left: 0.5rem;
    border-left: 1.5px solid #e2e8f0;
  }

  /* File Lists */
  .file-list {
    list-style: none;
    padding: 0;
    margin: 0.2rem 0;
  }
  .file-item {
    margin: 0.15rem 0;
  }
  .file-link {
    display: block;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    color: #64748b;
    text-decoration: none;
    line-height: 1.4;
    transition: all 0.1s ease;
  }
  .file-link:hover {
    background: #f8fafc;
    color: #0284c7;
    text-decoration: none;
  }

  /* Active Note Highlight */
  .file-link.active {
    background: #e0f2fe;
    color: #0284c7;
    font-weight: 600;
  }
</style>