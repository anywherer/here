---
import { getPublishedNotes, getFolderSlug } from '../utils';

interface TreeNode {
  folders: Map<string, TreeNode>;
  files: Array<{ title: string; slug: string }>;
}

const notes = await getPublishedNotes();
const root: TreeNode = { folders: new Map(), files: [] };

for (const note of notes) {
  const parts = note.entry.id.split('/');
  parts.pop();

  let current = root;
  for (const segment of parts) {
    if (!current.folders.has(segment)) {
      current.folders.set(segment, { folders: new Map(), files: [] });
    }
    current = current.folders.get(segment)!;
  }
  current.files.push({ title: note.title, slug: note.slug });
}

function escapeHtml(value: string): string {
  return value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function renderTree(node: TreeNode, path = ''): string {
  const buffer: string[] = [];

  const sortedFolders = Array.from(node.folders.entries())
    .sort(([a], [b]) => a.localeCompare(b));

  for (const [name, subFolder] of sortedFolders) {
    const folderPath = path ? `${path} › ${name}` : name;
    buffer.push(`
      <details class="folder-group" data-path="${escapeHtml(folderPath)}">
        <summary class="folder-summary">
          <span class="folder-arrow" aria-hidden="true">▾</span>
          <a class="folder-name" href="/folders/${escapeHtml(getFolderSlug(folderPath))}">${escapeHtml(name)}</a>
        </summary>
        <div class="folder-children">
          ${renderTree(subFolder, folderPath)}
        </div>
      </details>
    `);
  }

  const sortedFiles = [...node.files].sort((a, b) => a.title.localeCompare(b.title));
  if (sortedFiles.length > 0) {
    buffer.push('<ul class="file-list">');
    for (const file of sortedFiles) {
      buffer.push(`
        <li class="file-item">
          <a href="/${escapeHtml(file.slug)}" class="file-link">${escapeHtml(file.title)}</a>
        </li>
      `);
    }
    buffer.push('</ul>');
  }

  return buffer.join('');
}

const treeHtml = renderTree(root);
---

<nav-explorer class="explorer">
  <div class="explorer-header">Explorer</div>
  <div class="explorer-tree" set:html={treeHtml} />
</nav-explorer>

<script>
  class NavExplorer extends HTMLElement {
    private KEY = 'open-folders';
    private onPageLoad = () => this.markActive();

    connectedCallback() {
      this.restoreState();
      this.markActive();

      this.addEventListener('toggle', (e) => {
        const el = e.target as HTMLDetailsElement;
        const path = el.dataset.path;
        if (path) this.saveState(path, el.open);
      }, true);

      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.folder-name')) e.stopPropagation();
      });

      document.addEventListener('astro:page-load', this.onPageLoad);
    }

    disconnectedCallback() {
      document.removeEventListener('astro:page-load', this.onPageLoad);
    }

    private markActive() {
      this.querySelectorAll('.file-link.is-active').forEach((el) => {
        el.classList.remove('is-active');
      });

      const path = window.location.pathname.replace(/\/+$/, '') || '/';
      const link = this.querySelector(`.file-link[href="${CSS.escape(path)}"]`);
      if (!(link instanceof HTMLElement)) return;

      link.classList.add('is-active');
      let folder = link.closest('details');
      while (folder) {
        folder.open = true;
        this.saveState(folder.dataset.path || '', true);
        folder = folder.parentElement?.closest('details') ?? null;
      }
    }

    private restoreState() {
      try {
        const saved = localStorage.getItem(this.KEY);
        if (!saved) return;

        const openFolders = JSON.parse(saved) as string[];
        if (!Array.isArray(openFolders)) return;

        for (const path of openFolders) {
          const folder = this.querySelector(`details[data-path="${CSS.escape(path)}"]`);
          if (folder instanceof HTMLDetailsElement) folder.open = true;
        }
      } catch {
        localStorage.removeItem(this.KEY);
      }
    }

    private saveState(path: string, isOpen: boolean) {
      if (!path) return;
      let openFolders: string[] = [];
      try {
        openFolders = JSON.parse(localStorage.getItem(this.KEY) || '[]');
        if (!Array.isArray(openFolders)) openFolders = [];
      } catch {
        openFolders = [];
      }

      const next = new Set(openFolders);
      if (isOpen) next.add(path);
      else next.delete(path);
      localStorage.setItem(this.KEY, JSON.stringify([...next]));
    }
  }

  if (!customElements.get('nav-explorer')) {
    customElements.define('nav-explorer', NavExplorer);
  }
</script>

<style is:global>
  .explorer-header {
    font-size: 0.8rem;
    font-weight: 700;
    color: #64748b;
    letter-spacing: 0.02em;
    margin-bottom: 0.5rem;
  }

  .folder-group {
    margin-bottom: 0.25rem;
  }

  .folder-children {
    padding-left: 0.75rem;
    margin-left: 0.5rem;
    border-left: 1.5px solid #e2e8f0;
  }

  .folder-summary {
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.3rem;
    border-radius: 4px;
    color: #334155;
    font-weight: 500;
    list-style: none;
    user-select: none;
  }

  .folder-summary::-webkit-details-marker {
    display: none;
  }

  .folder-summary:hover {
    background: #f8fafc;
  }

  .folder-arrow {
    display: inline-block;
    font-size: 0.75rem;
    color: #94a3b8;
    width: 12px;
    text-align: center;
  }

  details:not([open]) > .folder-summary .folder-arrow {
    transform: rotate(-90deg);
  }

  .folder-name {
    color: inherit;
    text-decoration: none;
  }

  .folder-name:hover {
    text-decoration: underline;
  }

  .file-list {
    list-style: none;
    padding: 0;
    margin: 0.2rem 0;
  }

  .file-link {
    display: block;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    color: #64748b;
    text-decoration: none;
    line-height: 1.4;
  }

  .file-link:hover {
    background: #f0f9ff;
    color: #0369a1;
  }

  .file-link.is-active {
    background: #e0f2fe;
    color: #0369a1;
    font-weight: 600;
  }
</style>
