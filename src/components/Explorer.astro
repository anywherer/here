---
import { getCollection } from 'astro:content';
import { getPostMetadata, isPublished } from '../utils';

interface TreeNode {
  folders: Map<string, TreeNode>;
  files: Array<{ title: string; slug: string }>;
}

const allPosts = await getCollection('posts', isPublished);

const root: TreeNode = { folders: new Map(), files: [] };

for (const post of allPosts) {
  const { title, slug } = getPostMetadata(post);
  const parts = post.id.split('/');
  parts.pop(); // Remove filename

  let current = root;
  for (const segment of parts) {
    if (!current.folders.has(segment)) {
      current.folders.set(segment, { folders: new Map(), files: [] });
    }
    current = current.folders.get(segment)!;
  }
  current.files.push({ title, slug });
}

function renderTree(node: TreeNode, path = ''): string {
  let html = '';

  // Sort and render folders (collapsed by default: no `open` attribute)
  const sortedFolders = Array.from(node.folders.entries()).sort(([a], [b]) => a.localeCompare(b));
  for (const [name, subFolder] of sortedFolders) {
    const folderPath = path ? `${path}/${name}` : name;
    html += `
      <details class="folder-group" data-path="${folderPath}">
        <summary class="folder-summary">
          <span class="folder-arrow">▾</span>
          <span class="folder-name">${name}</span>
        </summary>
        <div class="folder-children">
          ${renderTree(subFolder, folderPath)}
        </div>
      </details>
    `;
  }

  // Sort and render files (NO trailing slash on links)
  const sortedFiles = node.files.sort((a, b) => a.title.localeCompare(b.title));
  if (sortedFiles.length > 0) {
    html += `<ul class="file-list">`;
    for (const file of sortedFiles) {
      html += `
        <li class="file-item">
          <a href="/${file.slug}" class="file-link">${file.title}</a>
        </li>
      `;
    }
    html += `</ul>`;
  }

  return html;
}

const treeHtml = renderTree(root);
---

<nav-explorer class="explorer">
  <div class="explorer-header">Explorer ▾</div>
  <div class="explorer-tree" set:html={treeHtml} />
</nav-explorer>

<script>
  class NavExplorer extends HTMLElement {
    connectedCallback() {
      const KEY = 'open-folders';
      const openFolders = new Set(JSON.parse(localStorage.getItem(KEY) || '[]'));

      // 1. Restore previously opened folders
      this.querySelectorAll<HTMLDetailsElement>('details[data-path]').forEach((el) => {
        if (openFolders.has(el.dataset.path)) el.open = true;
      });

      // 2. Save toggle states (capture phase captures unbubbled 'toggle' events)
      this.addEventListener('toggle', (e) => {
        const el = e.target as HTMLDetailsElement;
        const path = el.dataset.path;
        if (!path) return;

        if (el.open) openFolders.add(path);
        else openFolders.delete(path);

        localStorage.setItem(KEY, JSON.stringify([...openFolders]));
      }, true);
    }
  }

  if (!customElements.get('nav-explorer')) {
    customElements.define('nav-explorer', NavExplorer);
  }
</script>

<style is:global>
  nav-explorer.explorer {
    display: block;
    font-size: 0.88rem;
    user-select: none;
  }
  .explorer-header {
    font-weight: 700;
    margin-bottom: 0.6rem;
    color: #475569;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .folder-group {
    margin-bottom: 0.25rem;
  }
  .folder-summary {
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.3rem;
    border-radius: 4px;
    color: #334155;
    font-weight: 500;
    list-style: none;
    transition: background 0.1s ease;
  }
  .folder-summary::-webkit-details-marker {
    display: none;
  }
  .folder-summary:hover {
    background: #f1f5f9;
    color: #0369a1;
  }
  .folder-arrow {
    display: inline-block;
    font-size: 0.75rem;
    color: #94a3b8;
    transition: transform 0.15s ease;
    width: 12px;
    text-align: center;
  }
  details:not([open]) > .folder-summary .folder-arrow {
    transform: rotate(-90deg);
  }
  .folder-children {
    padding-left: 0.75rem;
    margin-left: 0.5rem;
    border-left: 1.5px solid #e2e8f0;
  }
  .file-list {
    list-style: none;
    padding: 0;
    margin: 0.2rem 0;
  }
  .file-item {
    margin: 0.15rem 0;
  }
  .file-link {
    display: block;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    color: #64748b;
    text-decoration: none;
    line-height: 1.4;
    transition: all 0.1s ease;
  }
  .file-link:hover {
    background: #f8fafc;
    color: #0284c7;
  }
</style>