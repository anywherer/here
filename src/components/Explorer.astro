---
import { getCollection } from 'astro:content';
import { getPostMetadata, isPublished } from '../utils';

interface TreeNode {
  folders: Map<string, TreeNode>;
  files: Array<{ title: string; slug: string }>;
}

const allPosts = await getCollection('posts', isPublished);
const root: TreeNode = { folders: new Map(), files: [] };

for (const post of allPosts) {
  const { title, slug } = getPostMetadata(post);
  const parts = post.id.split('/');
  parts.pop();

  let current = root;
  for (const segment of parts) {
    if (!current.folders.has(segment)) {
      current.folders.set(segment, { folders: new Map(), files: [] });
    }
    current = current.folders.get(segment)!;
  }
  current.files.push({ title, slug });
}

function renderTree(node: TreeNode, path = ''): string {
  let html = '';
  const sortedFolders = Array.from(node.folders.entries()).sort(([a], [b]) =>
    a.localeCompare(b)
  );

  for (const [name, subFolder] of sortedFolders) {
    const folderPath = path ? `${path}/${name}` : name;
    html += `
      <details class="folder-group" data-path="${folderPath}">
        <summary class="folder-summary">
          <span class="folder-arrow">▾</span>
          <span class="folder-name">${name}</span>
        </summary>
        <div class="folder-children">
          ${renderTree(subFolder, folderPath)}
        </div>
      </details>
    `;
  }

  const sortedFiles = node.files.sort((a, b) => a.title.localeCompare(b.title));
  if (sortedFiles.length > 0) {
    html += `<ul class="file-list">`;
    for (const file of sortedFiles) {
      html += `
        <li class="file-item">
          <a href="/${file.slug}" class="file-link" data-slug="${file.slug}">${file.title}</a>
        </li>
      `;
    }
    html += `</ul>`;
  }
  return html;
}

const treeHtml = renderTree(root);
const STORAGE_KEY = 'open-folders';
---

{/* Hide until localStorage is applied so the first paint is already the restored tree. */}
<style is:inline>
  #sidebar-explorer:not(.is-hydrated) { visibility: hidden; }
</style>

<nav-explorer
  class="explorer"
  id="sidebar-explorer"
  data-storage-key={STORAGE_KEY}
  transition:persist="sidebar-explorer"
>
  <div class="explorer-header">Explorer ▾</div>
  <div class="explorer-tree" set:html={treeHtml} />
</nav-explorer>

{/* Blocking: runs as soon as the tree is in the DOM, before paint of this subtree. */}
<script is:inline>
  (function hydrateExplorer() {
    var explorer = document.getElementById('sidebar-explorer');
    if (!explorer || explorer.classList.contains('is-hydrated')) return;

    var key = explorer.getAttribute('data-storage-key') || 'open-folders';
    var openFolders = [];
    try {
      openFolders = JSON.parse(localStorage.getItem(key) || '[]');
    } catch (e) {
      openFolders = [];
    }

    for (var i = 0; i < openFolders.length; i++) {
      var details = explorer.querySelector('details[data-path="' + CSS.escape(openFolders[i]) + '"]');
      if (details) details.open = true;
    }

    explorer.classList.add('is-hydrated');
  })();
</script>

<script>
  const STORAGE_KEY = 'open-folders';

  function persistOpenFolders(explorer: Element) {
    const open = [...explorer.querySelectorAll('details[data-path][open]')].map(
      (el) => (el as HTMLElement).dataset.path
    ).filter(Boolean);
    localStorage.setItem(STORAGE_KEY, JSON.stringify(open));
  }

  function bindExplorer(explorer: HTMLElement) {
    if (explorer.dataset.initialized === 'true') return;

    explorer.addEventListener(
      'toggle',
      (e) => {
        const el = e.target as HTMLDetailsElement;
        if (!(el instanceof HTMLDetailsElement) || !el.dataset.path) return;
        if (!explorer.contains(el)) return;
        persistOpenFolders(explorer);
      },
      true
    );

    explorer.dataset.initialized = 'true';
  }

  function initExplorer() {
    const explorer = document.getElementById('sidebar-explorer') as HTMLElement | null;
    if (!explorer) return;

    bindExplorer(explorer);
    explorer.classList.add('is-hydrated');
  }

  document.addEventListener('astro:page-load', initExplorer);
</script>

<style is:global>
  nav-explorer.explorer {
    display: block;
    font-size: 0.88rem;
    user-select: none;
  }

  nav-explorer.explorer:not(.is-hydrated) .folder-arrow {
    transition: none;
  }

  .folder-group:not([open]) .folder-arrow {
    transform: rotate(-90deg);
  }

  .folder-summary {
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.3rem;
    border-radius: 4px;
    color: #334155;
    font-weight: 500;
    list-style: none;
  }

  .folder-summary::-webkit-details-marker {
    display: none;
  }

  .folder-summary:hover {
    background: #f1f5f9;
    color: #0369a1;
  }

  .folder-arrow {
    display: inline-block;
    font-size: 0.75rem;
    color: #94a3b8;
    transition: transform 0.15s ease-out;
    width: 12px;
    text-align: center;
  }

  .folder-children {
    padding-left: 0.75rem;
    margin-left: 0.5rem;
    border-left: 1.5px solid #e2e8f0;
  }

  .file-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .file-link {
    display: block;
    padding: 0.2rem 0.3rem;
    border-radius: 4px;
    color: inherit;
    text-decoration: none;
  }
</style>
