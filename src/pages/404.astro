---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404" description="This page has not been found yet.">
  <div class="not-found">
    <h1>404</h1>
    <p>You've wandered somewhere that is yet to be found.</p>
    <a href="/" class="home-link">Return home</a>
  </div>
</Layout>

<style>
  .not-found {
    padding: 3rem 0;
    max-width: 600px;
  }
  h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    color: #0f172a;
  }
  p {
    color: #64748b;
    margin-bottom: 1.5rem;
  }
  .home-link {
    color: #0284c7;
    text-decoration: none;
    font-weight: 600;
  }
  .home-link:hover {
    text-decoration: underline;
  }
</style>
