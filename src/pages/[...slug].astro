---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { getPostMetadata, isPublished, formatDate } from '../utils';

export async function getStaticPaths() {
  const posts = await getCollection('posts', isPublished);

  return posts.map((post) => {
    const { slug } = getPostMetadata(post);
    return {
      params: { slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, folder } = getPostMetadata(post);
---

<Layout title={`${title}`}>
  <article class="post-container">
    <!-- Breadcrumbs -->
    <nav class="breadcrumbs">
      <a href="/">Home</a> › <span>{folder}</span>
    </nav>

    <!-- Header -->
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      <div class="post-meta">
        <time class="post-date">{formatDate(date)}</time>
        <div class="tags">
          {post.data.tags.map((t) => (
            <a href={`/tags/${t}`} class="tag-badge">#{t}</a>
          ))}
        </div>
      </div>
    </header>

    <!-- Obsidian-Style Markdown Body -->
    <div class="markdown-body">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .post-container {
    max-width: 720px;
  }

  .breadcrumbs {
    font-size: 0.85rem;
    color: #0284c7;
    margin-bottom: 1.25rem;
  }
  .breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    text-decoration: underline;
  }

  .post-header {
    margin-bottom: 2rem;
  }
  .post-title {
    font-size: 2rem;
    font-weight: 700;
    color: #1e293b;
    line-height: 1.25;
    margin-bottom: 0.5rem;
  }
  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #e2e8f0;
  }
  .post-date {
    font-size: 0.85rem;
    color: #64748b;
  }
  .tags {
    display: flex;
    gap: 0.35rem;
  }
  .markdown-body {
    font-size: 1rem;
    line-height: 1.65;
    color: #1e293b;
  }

  /* SINGLE LINE BREAKS ARE PRESERVED HERE */
  .markdown-body :global(p) {
    white-space: pre-line; /* Keeps every enter/return like Notepad */
    margin-bottom: 1rem;
  }

  /* Headings: Clean, solid, Obsidian-proportioned */
  .markdown-body :global(h1),
  .markdown-body :global(h2),
  .markdown-body :global(h3),
  .markdown-body :global(h4) {
    color: #0f172a;
    font-weight: 700;
    line-height: 1.3;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .markdown-body :global(h1) { font-size: 1.6rem; }
  .markdown-body :global(h2) { font-size: 1.35rem; }
  .markdown-body :global(h3) { font-size: 1.15rem; }
  .markdown-body :global(h4) { font-size: 1rem; }

  /* Links */
  .markdown-body :global(a) {
    color: #0284c7;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Obsidian-style Blockquote (simple vertical line, not italicized) */
  .markdown-body :global(blockquote) {
    margin: 1rem 0;
    padding: 0.2rem 0 0.2rem 0.9rem;
    border-left: 3px solid #cbd5e1;
    color: #475569;
    font-style: normal;
  }
  .markdown-body :global(blockquote p) {
    margin-bottom: 0.4rem;
  }
  .markdown-body :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  /* Lists */
  .markdown-body :global(ul),
  .markdown-body :global(ol) {
    margin: 0.75rem 0 1rem 0;
    padding-left: 1.4rem;
  }
  .markdown-body :global(li) {
    margin-bottom: 0.25rem;
  }

  /* Inline Code (Obsidian gray pill) */
  .markdown-body :global(code:not(pre code)) {
    background: #f1f5f9;
    color: #b91c1c;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9em;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
  }

  /* Code Blocks */
  .markdown-body :global(pre) {
    margin: 1.25rem 0;
    padding: 0.85rem 1rem;
    background: #1e293b;
    border-radius: 6px;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.5;
    white-space: pre; /* Don't pre-line inside code blocks */
  }
  .markdown-body :global(pre code) {
    background: transparent;
    color: #e2e8f0;
    padding: 0;
  }

  /* Horizontal Rules */
  .markdown-body :global(hr) {
    border: none;
    height: 1px;
    background: #e2e8f0;
    margin: 2rem 0;
  }

  /* Images */
  .markdown-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
    margin: 1rem 0;
    display: block;
  }
  .markdown-body :global(mark) {
    background-color: #fef08a;
    color: inherit;
    padding: 0.1em 0.35em;
    border-radius: 3px;
  }
</style>