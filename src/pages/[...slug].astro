---
import { render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { collectRoutes, folderTrail, formatDate, getPublishedNotes, getTagSlug } from '../utils';

export async function getStaticPaths() {
  const notes = await getPublishedNotes();
  const routes = collectRoutes(notes);

  return [...routes.entries()].map(([slug, note]) => ({
    params: { slug },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note.entry);
const description = note.entry.data.description || `${note.title} — a note from here.`;
---

<Layout title={note.title} description={description} canonicalPath={`/${note.slug}`}>
  <article class="post-container">
    <nav class="breadcrumbs">
      <a href="/">Home</a>
      {folderTrail(note.folderParts).map((room) => (
        <>
          {' › '}
          <a href={room.href}>{room.name}</a>
        </>
      ))}
    </nav>

    <header class="post-header">
      <h1 class="post-title">{note.title}</h1>
      <div class="post-meta">
        <time class="post-date" datetime={note.date.toISOString()}>{formatDate(note.date)}</time>
        <div class="tags">
          {note.tags.map((t) => (
            <a href={`/tags/${getTagSlug(t)}`} class="tag-badge">#{t}</a>
          ))}
        </div>
      </div>
    </header>

    <div class="markdown-body">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .post-container {
    max-width: 720px;
  }

  .post-header {
    margin-bottom: 2rem;
  }
  .post-title {
    font-size: 2rem;
    font-weight: 700;
    color: #1e293b;
    line-height: 1.25;
    margin-bottom: 0.5rem;
  }
  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #e2e8f0;
  }
  .post-date {
    font-size: 0.85rem;
    color: #64748b;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .markdown-body {
    font-size: 1rem;
    line-height: 1.65;
    color: #1e293b;
  }

  .markdown-body :global(p) {
    white-space: pre-line;
    margin-bottom: 1rem;
  }

  .markdown-body :global(h1),
  .markdown-body :global(h2),
  .markdown-body :global(h3),
  .markdown-body :global(h4) {
    color: #0f172a;
    font-weight: 700;
    line-height: 1.3;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .markdown-body :global(h1) { font-size: 1.6rem; }
  .markdown-body :global(h2) { font-size: 1.35rem; }
  .markdown-body :global(h3) { font-size: 1.15rem; }
  .markdown-body :global(h4) { font-size: 1rem; }

  .markdown-body :global(a) {
    color: #0284c7;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .markdown-body :global(blockquote) {
    margin: 1rem 0;
    padding: 0.2rem 0 0.2rem 0.9rem;
    border-left: 3px solid #cbd5e1;
    color: #475569;
  }
  .markdown-body :global(blockquote p) {
    margin-bottom: 0.4rem;
  }
  .markdown-body :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .markdown-body :global(ul),
  .markdown-body :global(ol) {
    margin: 0.75rem 0 1rem 0;
    padding-left: 1.4rem;
  }
  .markdown-body :global(li) {
    margin-bottom: 0.25rem;
  }

  .markdown-body :global(code:not(pre code)) {
    background: #f1f5f9;
    color: #b91c1c;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9em;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
  }

  .markdown-body :global(pre) {
    margin: 1.25rem 0;
    padding: 0.85rem 1rem;
    background: #1e293b;
    border-radius: 6px;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.5;
    white-space: pre;
  }
  .markdown-body :global(pre code) {
    background: transparent;
    color: #e2e8f0;
    padding: 0;
  }

  .markdown-body :global(hr) {
    border: none;
    height: 1px;
    background: #e2e8f0;
    margin: 2rem 0;
  }

  .markdown-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
    margin: 1rem 0;
    display: block;
  }
  .markdown-body :global(mark) {
    background-color: #fef08a;
    color: inherit;
    padding: 0.1em 0.35em;
    border-radius: 3px;
  }
</style>
