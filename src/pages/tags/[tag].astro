---
import Layout from '../../layouts/Layout.astro';
import NoteList from '../../components/NoteList.astro';
import { getPublishedNotes, getTagSlug } from '../../utils';

export async function getStaticPaths() {
  const notes = await getPublishedNotes();
  const tags = [...new Set(notes.flatMap((note) => note.tags))];

  return tags.map((tag) => ({
    params: { tag: getTagSlug(tag) },
    props: {
      tag,
      notes: notes.filter((note) => note.tags.includes(tag)),
    },
  }));
}

const { tag, notes } = Astro.props;
---

<Layout title={`#${tag}`} description={`${notes.length} notes tagged ${tag}.`}>
  <nav class="breadcrumbs">
    <a href="/">Home</a> › <span>tags</span> › <span>#{tag}</span>
  </nav>

  <h1 class="folder-heading">#{tag}</h1>
  <p class="folder-count">{notes.length} items with this tag.</p>

  <NoteList notes={notes} />
</Layout>

<style>
  .folder-heading {
    font-size: 1.75rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }
  .folder-count {
    color: #4b5563;
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }
</style>
