---
import Layout from '../../layouts/Layout.astro';
import NoteList from '../../components/NoteList.astro';
import { getFolderSlug, getPublishedNotes } from '../../utils';

export async function getStaticPaths() {
  const notes = await getPublishedNotes();
  const folders = [...new Set(notes.map((note) => note.folder))];

  return folders.map((folderName) => ({
    params: { folder: getFolderSlug(folderName) },
    props: {
      folderName,
      notes: notes.filter((note) => note.folder === folderName),
    },
  }));
}

const { folderName, notes } = Astro.props;
---

<Layout title={folderName} description={`${notes.length} notes in ${folderName}.`}>
  <nav class="breadcrumbs">
    <a href="/">Home</a> › <span>{folderName}</span>
  </nav>

  <h1 class="folder-heading">{folderName}</h1>
  <p class="folder-count">{notes.length} items under this folder.</p>

  <NoteList notes={notes} />
</Layout>

<style>
  .folder-heading {
    font-size: 1.75rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }
  .folder-count {
    color: #4b5563;
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }
</style>
