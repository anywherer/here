---
import Layout from '../layouts/Layout.astro';
import NoteList from '../components/NoteList.astro';
import { getPublishedNotes } from '../utils';
import { SITE } from '../site';

const notes = await getPublishedNotes();
---

<Layout title={SITE.title} description={SITE.description}>
  <div class="welcome-header">
    <h1>all thoughts</h1>
    <p>{notes.length} entries across the house, sorted by date.</p>
  </div>

  <NoteList notes={notes} />
</Layout>

<style>
  .welcome-header { margin-bottom: 2rem; }
  .welcome-header h1 { font-size: 1.75rem; font-weight: 800; margin-bottom: 0.25rem; }
  .welcome-header p { color: #6b7280; font-size: 0.9rem; }
</style>
