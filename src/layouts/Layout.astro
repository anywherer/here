---
import { ClientRouter } from 'astro:transitions';
import Explorer from '../components/Explorer.astro';
import Search from '../components/Search.astro';
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const { title = SITE.title, description = SITE.description, canonicalPath } = Astro.props;
const pageTitle = title === SITE.title ? SITE.title : `${title} · ${SITE.title}`;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site ?? SITE.fallbackUrl);
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="data:," />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={new URL('rss.xml', Astro.site ?? SITE.fallbackUrl)} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-container">
      <main
        id="main"
        class="content"
        tabindex="-1"
        transition:name="main-content"
        transition:animate="none"
      >
        <slot />
      </main>

      <aside class="sidebar" aria-label="Site" transition:persist="sidebar">
        <header>
          <a href="/" class="brand">{SITE.title}</a>
        </header>
        <Search />
        <nav aria-label="Notes">
          <Explorer />
        </nav>
      </aside>
    </div>
    <script is:inline>
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const link = target.closest('a');
        if (!(link instanceof HTMLAnchorElement)) return;
        const href = link.getAttribute('href') || '';
        if (!href || href.startsWith('#') || href.startsWith('javascript:')) return;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
      }, true);
    </script>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --vt-in: 240ms;
    --ease-expo: cubic-bezier(0.16, 1, 0.3, 1);
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }

  header, nav, footer, .sidebar {
    view-transition-name: none;
  }

  ::view-transition-old(main-content) {
    animation: none !important;
    display: none;
  }

  ::view-transition-group(main-content) {
    animation: none;
  }

  ::view-transition-new(main-content) {
    animation: content-in var(--vt-in) var(--ease-expo) both;
  }

  @keyframes content-in {
    from { opacity: 0.14; }
    to   { opacity: 1; }
  }

  [data-astro-transition-fallback="old"] .content {
    opacity: 0;
  }

  [data-astro-transition-fallback="new"] .content {
    animation: content-in var(--vt-in) var(--ease-expo) both;
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }

    [data-astro-transition-fallback="old"] .content,
    [data-astro-transition-fallback="new"] .content {
      animation: none !important;
      opacity: 1;
    }
  }

  body {
    font-family: Comic Sans MS, Chalkboard SE, Arial, sans-serif;
    color: #1a1a1a;
    background: #fff;
    line-height: 1.6;
    overflow-y: scroll;
  }

  .site-container {
    display: grid;
    grid-template-columns: 1fr 280px;
    grid-template-areas: "content sidebar";
    max-width: 1200px;
    margin: 0 auto;
    min-height: 100vh;
    padding: 2rem;
    gap: 3rem;
  }

  .sidebar {
    grid-area: sidebar;
    position: sticky;
    top: 2rem;
    align-self: start;
  }

  .content { grid-area: content; }

  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 100;
    padding: 0.4rem 0.7rem;
    background: #0f4c81;
    color: #fff;
    text-decoration: none;
    border-radius: 4px;
  }

  .skip-link:focus { top: 1rem; }

  .brand {
    font-size: 1.5rem;
    font-weight: 700;
    text-decoration: none;
    color: #0f4c81;
    display: inline-block;
    margin-bottom: 1.5rem;
  }

  .tag-badge {
    display: inline-block;
    background: #e6f4f1;
    color: #0d685c;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    text-decoration: none;
  }
  .tag-badge:hover {
    background: #ccebe5;
  }

  .breadcrumbs {
    font-size: 0.85rem;
    color: #0284c7;
    margin-bottom: 1.25rem;
  }
  .breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    text-decoration: underline;
  }

  @media (max-width: 800px) {
    .site-container {
      grid-template-columns: 1fr;
      grid-template-areas: "content" "sidebar";
      gap: 1.5rem;
    }
  }
</style>
