---
import { ClientRouter } from 'astro:transitions';
import Explorer from '../components/Explorer.astro';
import Search from '../components/Search.astro';

interface Props {
  title?: string;
}

const { title = "here" } = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <link rel="icon" href="data:," />
    <link rel="alternate" type="application/rss+xml" title="here" href={new URL("rss.xml", Astro.site)} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-container">
      <main
        id="main"
        class="content"
        tabindex="-1"
        transition:name="main-content"
        transition:animate="none"
      >
        <slot />
      </main>

      <aside class="sidebar" aria-label="Site" transition:persist="sidebar">
        <header>
          <a href="/" class="brand">here</a>
        </header>
        <Search />
        <nav aria-label="Notes">
          <Explorer />
        </nav>
      </aside>
    </div>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --vt-in: 240ms;
    --ease-expo: cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Kill the giant root snapshot so only main actually transitions */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }

  header, nav, footer, .chrome, .sidebar {
    view-transition-name: none;
  }

  /* Old content: gone immediately. No fade, no slide. */
  ::view-transition-old(main-content) {
    animation: none !important;
    display: none;
  }

  /* New content: already in place, starts dim, eases hard to 1 */
  ::view-transition-group(main-content) {
    animation: none;
  }

  ::view-transition-new(main-content) {
    animation: content-in var(--vt-in) var(--ease-expo) both;
  }

  @keyframes content-in {
    from { opacity: 0.14; }
    to   { opacity: 1; }
  }

  /* Fallback path for browsers without native VT */
  [data-astro-transition-fallback="old"] .content {
    opacity: 0;
  }

  [data-astro-transition-fallback="new"] .content {
    animation: content-in var(--vt-in) var(--ease-expo) both;
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }

    [data-astro-transition-fallback="old"] .content,
    [data-astro-transition-fallback="new"] .content {
      animation: none !important;
      opacity: 1;
    }
  }

  .content img,
  .content video {
    content-visibility: auto;
  }

  body {
    font-family: Comic Sans MS, Chalkboard SE, Arial, sans-serif;
    color: #1a1a1a;
    background: #fff;
    line-height: 1.6;
    overflow-y: scroll;
  }

  .site-container {
    display: grid;
    grid-template-columns: 1fr 280px;
    grid-template-areas: "content sidebar";
    max-width: 1200px;
    margin: 0 auto;
    min-height: 100vh;
    padding: 2rem;
    gap: 3rem;
  }

  .sidebar {
    grid-area: sidebar;
    position: sticky;
    top: 2rem;
    align-self: start;
  }

  .content { grid-area: content; }

  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 100;
    padding: 0.4rem 0.7rem;
    background: #0f4c81;
    color: #fff;
    text-decoration: none;
    border-radius: 4px;
    transition: top 0.2s;
  }

  .skip-link:focus { top: 1rem; }

  .brand {
    font-size: 1.5rem;
    font-weight: 700;
    text-decoration: none;
    color: #0f4c81;
    display: inline-block;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 800px) {
    .site-container {
      grid-template-columns: 1fr;
      grid-template-areas: "content" "sidebar";
      gap: 1.5rem;
    }
  }
</style>