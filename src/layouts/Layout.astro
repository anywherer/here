---
import { ClientRouter } from 'astro:transitions';
import Explorer from '../components/Explorer.astro';
import Search from '../components/Search.astro';

interface Props {
  title?: string;
}
const { title = "here" } = Astro.props;

/* Notebook swap — not a site fade, not a full slide. */
const noteOut = {
  name: 'note-out',
  duration: '130ms',
  easing: 'cubic-bezier(0.4, 0, 1, 1)',
  fillMode: 'both',
};
const noteIn = {
  name: 'note-in',
  duration: '240ms',
  easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
  fillMode: 'both',
};
const noteOutBack = { ...noteOut, name: 'note-out-back' };
const noteInBack = { ...noteIn, name: 'note-in-back' };

const noteSwap = {
  forwards:  { old: noteOut, new: noteIn },
  backwards: { old: noteOutBack, new: noteInBack },
};
---
<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <link rel="icon" href="data:," />
    <link rel="alternate" type="application/rss+xml" title="here" href={new URL("rss.xml", Astro.site)} />
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="site-container">
      <main
        id="main"
        class="content"
        tabindex="-1"
        transition:name="main-content"
        transition:animate={noteSwap}
      >
        <slot />
      </main>

      <aside class="sidebar" aria-label="Site" transition:persist="sidebar">
        <header>
          <a href="/" class="brand">here</a>
        </header>
        <Search />
        <nav aria-label="Notes">
          <Explorer />
        </nav>
      </aside>
    </div>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  /* Cheap snapshots only. Don't morph the whole document. */
  ::view-transition {
    pointer-events: none;
  }
  ::view-transition-group(root) {
    animation: none;
  }
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }
  ::view-transition-group(main-content) {
    overflow: clip;
  }

  @keyframes note-out {
    to { opacity: 0; transform: translateY(-8px); }
  }
  @keyframes note-in {
    from { opacity: 0; transform: translateY(12px); }
  }
  @keyframes note-out-back {
    to { opacity: 0; transform: translateY(8px); }
  }
  @keyframes note-in-back {
    from { opacity: 0; transform: translateY(-12px); }
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }

  body {
    font-family: Comic Sans MS, Chalkboard SE, Arial, sans-serif;
    color: #1a1a1a;
    background: #fff;
    line-height: 1.6;
    overflow-y: scroll;
  }

  .site-container {
    display: grid;
    grid-template-columns: 1fr 280px;
    grid-template-areas: "content sidebar";
    max-width: 1200px;
    margin: 0 auto;
    min-height: 100vh;
    padding: 2rem;
    gap: 3rem;
  }

  .sidebar {
    grid-area: sidebar;
    position: sticky;
    top: 2rem;
    align-self: start;
  }

  .content { grid-area: content; }

  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 100;
    padding: 0.4rem 0.7rem;
    background: #0f4c81;
    color: #fff;
    text-decoration: none;
    border-radius: 4px;
    transition: top 0.2s;
  }
  .skip-link:focus { top: 1rem; }

  .brand {
    font-size: 1.5rem;
    font-weight: 700;
    text-decoration: none;
    color: #0f4c81;
    display: inline-block;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 800px) {
    .site-container {
      grid-template-columns: 1fr;
      grid-template-areas: "content" "sidebar";
      gap: 1.5rem;
    }
    .sidebar { position: static; }
  }
</style>