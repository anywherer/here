---
import { ClientRouter } from 'astro:transitions';
import Explorer from '../components/Explorer.astro';
import Search from '../components/Search.astro';

interface Props {
  title?: string;
}
const { title = "here" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <link rel="icon" href="data:," />
    <link rel="alternate" type="application/rss+xml" title="here" href={new URL("rss.xml", Astro.site)} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="site-container">
      <!-- 
        1. Added transition:animate="fade" specifically to the main content.
        2. Added a unique transition:name so the browser knows this is the moving part.
      -->
      <main 
        id="main" 
        class="content" 
        tabindex="-1" 
        transition:animate="initial"
        style="view-transition-name: main-content;"
      >
        <slot />
      </main>

      <!-- 
        transition:persist ensures the sidebar and the Explorer 
        state (scroll position/open folders) NEVER resets.
      -->
      <aside class="sidebar" aria-label="Site" transition:persist="sidebar">
        <header>
          <a href="/" class="brand">here</a>
        </header>
        <Search />
        <nav aria-label="Notes">
          <Explorer />
        </nav>
      </aside>
    </div>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --vt-out: 140ms;
    --vt-in: 220ms;
    --ease-out: cubic-bezier(0.4, 0, 1, 1);     /* leave fast */
    --ease-in:  cubic-bezier(0.16, 1, 0.3, 1);  /* land soft */
  }

  /* Only snapshot what actually changes */
  .main-content {
    view-transition-name: main-content;
  }

  /* Don’t let the browser animate the giant root snapshot */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
  }

  ::view-transition-group(main-content) {
    animation-duration: var(--vt-in);
    animation-timing-function: var(--ease-in);
  }

  ::view-transition-old(main-content) {
    animation: fade-out var(--vt-out) var(--ease-out) both;
  }

  ::view-transition-new(main-content) {
    animation: fade-in var(--vt-in) var(--ease-in) both;
  }

  @keyframes fade-out {
    to {
      opacity: 0;
      transform: translateY(-2px);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root),
    ::view-transition-old(main-content),
    ::view-transition-new(main-content) {
      animation: none !important;
    }
  }

  /* Disable standard root morphing to prevent the "whole page blink" */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }
  /* Stop headers/nav/footers from getting captured into the morph */
  header, nav, footer, .chrome {
    view-transition-name: none;
  }

  /* If images/video in main would make a fat snapshot */
  .main-content img,
  .main-content video {
    content-visibility: auto;
  }
  /* --- Base Styles --- */
  body {
    font-family: Comic Sans MS, Chalkboard SE, Arial, sans-serif;
    color: #1a1a1a;
    background: #fff;
    line-height: 1.6;
    overflow-y: scroll; /* Prevents layout shift from scrollbar appearing/disappearing */
  }

  .site-container {
    display: grid;
    grid-template-columns: 1fr 280px;
    grid-template-areas: "content sidebar";
    max-width: 1200px;
    margin: 0 auto;
    min-height: 100vh;
    padding: 2rem;
    gap: 3rem;
  }

  .sidebar { 
    grid-area: sidebar;
    height: sticky;
    top: 2rem;
    align-self: start;
  }
  
  .content { grid-area: content; }

  /* --- Accessibility & Utilities --- */
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 100;
    padding: 0.4rem 0.7rem;
    background: #0f4c81;
    color: #fff;
    text-decoration: none;
    border-radius: 4px;
    transition: top 0.2s;
  }
  .skip-link:focus { top: 1rem; }

  .brand {
    font-size: 1.5rem;
    font-weight: 700;
    text-decoration: none;
    color: #0f4c81;
    display: inline-block;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 800px) {
    .site-container {
      grid-template-columns: 1fr;
      grid-template-areas: "content" "sidebar";
      gap: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
</style>