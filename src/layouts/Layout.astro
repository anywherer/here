---
import { ClientRouter } from 'astro:transitions';
import Explorer from '../components/Explorer.astro';
import Search from '../components/Search.astro';

interface Props {
  title?: string;
}
const { title = "here ♡" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <link rel="icon" href="data:," />
    <link rel="alternate" type="application/rss+xml" title="here ♡" href={new URL("rss.xml", Astro.site)} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="site-container">
      <main id="main" class="content" tabindex="-1">
        <slot />
      </main>

      <aside class="sidebar" aria-label="Site" transition:persist>
        <header>
          <a href="/" class="brand">here ♡</a>
        </header>
        <Search />
        <nav aria-label="Notes">
          <Explorer />
        </nav>
      </aside>
    </div>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 60ms;
    animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    mix-blend-mode: normal;
  }
  ::view-transition-old(root) {
    opacity: 1;
  }
  ::view-transition-new(root) {
    opacity: 0;
  }
  .astro-route-announcer { display: none; }
  body {
    font-family: Arial, sans-serif;
    color: #1a1a1a;
    background: #fff;
    line-height: 1.6;
  }

  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 100;
    padding: 0.4rem 0.7rem;
    background: #0f4c81;
    color: #fff;
    text-decoration: none;
    border-radius: 4px;
  }
  .skip-link:focus {
    top: 1rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .site-container {
    display: grid;
    grid-template-columns: 1fr 280px;
    grid-template-areas: "content sidebar";
    max-width: 1200px;
    margin: 0 auto;
    min-height: 100vh;
    padding: 2rem;
    gap: 3rem;
  }
  .sidebar { grid-area: sidebar; }
  .content { grid-area: content; }

  .content:focus {
    outline: none;
  }

  a:focus-visible,
  input:focus-visible,
  button:focus-visible {
    outline: 2px solid #0284c7;
    outline-offset: 2px;
  }

  @media (max-width: 800px) {
    .site-container {
      grid-template-columns: 1fr;
      grid-template-areas:
        "content"
        "sidebar";
      gap: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      view-transition-name: none;
    }
    *, *::before, *::after {
      animation: none !important;
      transition: none !important;
    }
  }

  .brand {
    font-size: 1.5rem;
    font-weight: 700;
    text-decoration: none;
    color: #0f4c81;
    display: inline-block;
    margin-bottom: 1.5rem;
  }

  .tag-badge {
    display: inline-block;
    background: #e6f4f1;
    color: #0d685c;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    text-decoration: none;
    margin-left: 0.25rem;
  }
  .tag-badge:hover {
    background: #ccebe5;
  }

</style>