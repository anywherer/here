---
import { ClientRouter } from "astro:transitions";
import Explorer from "../components/Explorer.astro";
import Search from "../components/Search.astro";

interface Props {
  title?: string;
}
const { title = "here" } = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <link rel="icon" href="data:," />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="here"
      href={new URL("rss.xml", Astro.site)}
    />
    <!-- swap = no fake fade on browsers without View Transitions -->
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="site-container">
      <main
        id="main"
        class="content"
        tabindex="-1"
        transition:name="main-content"
        transition:animate="none"
      >
        <slot />
      </main>

      <aside class="sidebar" aria-label="Site" transition:persist="sidebar">
        <header>
          <a href="/" class="brand">here</a>
        </header>
        <Search />
        <nav aria-label="Notes">
          <Explorer />
        </nav>
      </aside>
    </div>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --shutter: #111;
    --shutter-close: 140ms;
    --shutter-hold: 50ms;
    --shutter-open: 200ms;
    --ease-close: cubic-bezier(0.6, 0.02, 0.9, 0.35);
    --ease-open: cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Named only on main. Sidebar persists, so don't snapshot it. */
  .content {
    view-transition-name: main-content;
  }

  header,
  nav,
  footer,
  .sidebar,
  .chrome {
    view-transition-name: none;
  }

  /* Kill the full-page morph. That's the blink you were getting. */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }

  ::view-transition-image-pair(root) {
    isolation: auto;
  }

  /*
    Group is the shutter body.
    When both snapshots clip to a slit, this colour is the blades.
  */
  ::view-transition-group(main-content) {
    background: var(--shutter);
    overflow: clip;
    animation: none;
  }

  ::view-transition-image-pair(main-content) {
    isolation: auto;
  }

  ::view-transition-old(main-content),
  ::view-transition-new(main-content) {
    mix-blend-mode: normal;
    height: 100%;
    object-fit: none;
    object-position: top left;
  }

  /* Old note gets eaten by two blades meeting in the middle */
  ::view-transition-old(main-content) {
    z-index: 2;
    animation: shutter-close var(--shutter-close) var(--ease-close) both;
  }

  /* New note waits for the click, then blades peel open */
  ::view-transition-new(main-content) {
    z-index: 1;
    animation: shutter-open var(--shutter-open) var(--ease-open) both;
    animation-delay: calc(var(--shutter-close) + var(--shutter-hold));
  }

  @keyframes shutter-close {
    from {
      clip-path: inset(0 0 0 0);
    }
    to {
      clip-path: inset(50% 0 50% 0);
    }
  }

  @keyframes shutter-open {
    from {
      clip-path: inset(50% 0 50% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }

  /* --- Base --- */
  body {
    font-family: Comic Sans MS, Chalkboard SE, Arial, sans-serif;
    color: #1a1a1a;
    background: #fff;
    line-height: 1.6;
    overflow-y: scroll;
  }

  .site-container {
    display: grid;
    grid-template-columns: 1fr 280px;
    grid-template-areas: "content sidebar";
    max-width: 1200px;
    margin: 0 auto;
    min-height: 100vh;
    padding: 2rem;
    gap: 3rem;
  }

  .sidebar {
    grid-area: sidebar;
    position: sticky;
    top: 2rem;
    align-self: start;
  }

  .content {
    grid-area: content;
  }

  .content img,
  .content video {
    content-visibility: auto;
  }

  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 100;
    padding: 0.4rem 0.7rem;
    background: #0f4c81;
    color: #fff;
    text-decoration: none;
    border-radius: 4px;
    transition: top 0.2s;
  }
  .skip-link:focus {
    top: 1rem;
  }

  .brand {
    font-size: 1.5rem;
    font-weight: 700;
    text-decoration: none;
    color: #0f4c81;
    display: inline-block;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 800px) {
    .site-container {
      grid-template-columns: 1fr;
      grid-template-areas: "content" "sidebar";
      gap: 1.5rem;
    }

    .sidebar {
      position: static;
    }
  }
</style>
